<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  What All Set needs from macOS under the hardened runtime, which every build
  uses (scripts/build-app.sh), so a dev build behaves like a notarized one.
  The app isn't sandboxed. Nothing else is granted: no JIT, no unsigned
  executable memory, no disabled library validation, no Apple Events.

  personal-information.calendars: the Calendar and Next Event widgets read
    events with EventKit; under the hardened runtime that fails without it.
  device.audio-input: the Sound Mixer taps other apps' audio with Core Audio
    process taps ("System Audio Recording Only"). Apple doesn't document
    whether taps need this key under the hardened runtime; it's included so
    the mixer can't break on a signed build (see Documentation/DECISIONS.md).
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
